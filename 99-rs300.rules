# Udev rule for RS300 Thermal Camera Media Controller Auto-Configuration
#
# This rule automatically configures the media controller pipeline when
# the RS300 camera is detected on the media controller device.
#
# Installation:
#   sudo cp 99-rs300.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules
#   sudo udevadm trigger
#
# Documentation: See BOOT_CONFIGURATION.md for details
#
# How this works:
# 1. udev detects when /dev/media* device is added
# 2. Checks if the device contains the RS300 sensor entity
# 3. If found, runs configure_media.sh after a brief delay
# 4. Delay ensures all subsystems are ready before configuration
#
# NOTE: Update the script path below to match your installation directory

# Rule 1: Detect media controller device with RS300 sensor
# Trigger on media device add event, check for RS300 entity in topology
ACTION=="add", SUBSYSTEM=="media", KERNEL=="media[0-9]*", \
  PROGRAM="/bin/sh -c 'media-ctl -d /dev/%k --print-topology 2>/dev/null | grep -q \"rs300 10-003c\"'", \
  RUN+="/bin/bash -c 'sleep 2 && /home/cody/rs300-v4l2-driver/configure_media.sh --non-interactive > /var/log/rs300-udev-config.log 2>&1'"

# Rule 2: Alternative trigger on I2C device detection (RS300 on bus 10, address 0x3c)
# This provides a secondary trigger point earlier in the initialization sequence
ACTION=="add", SUBSYSTEM=="i2c", ATTR{name}=="rs300*", \
  RUN+="/bin/bash -c 'sleep 3 && /home/cody/rs300-v4l2-driver/configure_media.sh --non-interactive > /var/log/rs300-udev-config-i2c.log 2>&1'"

# Debug: Set environment variable to enable verbose logging
# Uncomment the line below to enable debug output in udev logs
# ENV{UDEV_LOG}="debug"
