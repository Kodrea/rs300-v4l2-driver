#!/bin/bash
#
# RS300 Thermal Camera Control Tool
# Version: 1.0.0
#
# Professional CLI tool for managing RS300 thermal camera on Raspberry Pi 5
# Follows Linux conventions for installation, configuration, and activation
#
# Usage: rs300 <command> [options]
# Run 'rs300 help' for more information
#

set -e

# ============================================================================
# CONFIGURATION
# ============================================================================

VERSION="1.0.0"

# Color codes
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
BOLD='\033[1m'
NC='\033[0m'  # No Color

# Directories
RS300_DIR="${HOME}/.rs300"
RS300_LOGS="${RS300_DIR}/logs"
RS300_BACKUPS="${RS300_DIR}/backups"
RS300_CONFIG="${RS300_DIR}/config"
SYSTEM_LOG="${RS300_LOGS}/system.log"

# Default configuration
LOG_RETENTION_DAYS=30
INCLUDE_HOSTNAME=1
INCLUDE_DMESG=1
AUTO_ROTATE_COUNT=10
RS300_DEBUG=0

# Load user configuration if exists
[ -f "${RS300_CONFIG}" ] && source "${RS300_CONFIG}"

# ============================================================================
# LOGGING INFRASTRUCTURE
# ============================================================================

# Print formatted messages
print_status() {
    echo -e "${BLUE}▶${NC} $1"
}

print_success() {
    echo -e "${GREEN}✅${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}⚠️${NC} $1"
}

print_error() {
    echo -e "${RED}❌${NC} $1"
}

print_debug() {
    [ "$RS300_DEBUG" = "1" ] && echo -e "${BLUE}[DEBUG]${NC} $1"
}

print_header() {
    echo -e "${BOLD}$1${NC}"
}

# Initialize RS300 directory structure
init_rs300_dirs() {
    if ! mkdir -p "${RS300_LOGS}"/{test,configure,doctor,enable} 2>/dev/null; then
        # Fallback to /tmp if home not writable
        RS300_DIR="/tmp/rs300-${USER}"
        RS300_LOGS="${RS300_DIR}/logs"
        RS300_BACKUPS="${RS300_DIR}/backups"
        mkdir -p "${RS300_LOGS}"/{test,configure,doctor,enable}
        print_warning "Using fallback log directory: ${RS300_DIR}"
    fi
    mkdir -p "${RS300_BACKUPS}" 2>/dev/null || true
}

# Create command-specific log file with header
create_log_file() {
    local command="$1"
    local timestamp=$(date +%Y%m%d-%H%M%S)
    local logfile="${RS300_LOGS}/${command}/${timestamp}.log"

    # Create log file with header
    cat > "$logfile" <<EOF
=== RS300 ${command^^} Command Log ===
Timestamp: $(date '+%Y-%m-%d %H:%M:%S')
User: ${USER}
Test ID: ${command}-${timestamp}
Version: ${VERSION}

EOF
    echo "$logfile"
}

# Log essential environment information (always included, ~15 lines)
log_essential_env() {
    local logfile="$1"

    cat >> "$logfile" <<EOF
=== Essential Environment ===
OS: $(grep PRETTY_NAME /etc/os-release 2>/dev/null | cut -d'"' -f2 || echo "Unknown")
Kernel: $(uname -r)
Architecture: $(uname -m)
Pi Model: $(grep "Model" /proc/cpuinfo 2>/dev/null | cut -d':' -f2 | xargs || echo "Unknown")
Driver: $(dkms status | grep rs300 | head -1 || echo "Not installed via DKMS")

EOF
}

# Capture full system context (for failures and doctor, ~100 lines)
capture_system_context() {
    local logfile="$1"

    cat >> "$logfile" <<EOF
=== System Context ===
Uptime: $(uptime -p 2>/dev/null || uptime)
Load: $(uptime | awk -F'load average:' '{print $2}')

--- DKMS Status ---
$(dkms status 2>&1)

--- Loaded Modules ---
$(lsmod | grep -E "rs300|rp1_cfe|unicam" || echo "No camera modules loaded")

--- I2C Detection ---
$(i2cdetect -y 10 2>&1 || echo "I2C scan failed")

--- Video Devices ---
$(v4l2-ctl --list-devices 2>&1 || echo "No video devices found")

--- Media Controller Topology ---
$(media-ctl --print-topology 2>&1 | head -100 || echo "Media controller not available")

--- Config.txt Camera Section ---
$(grep -E "camera|dtoverlay" /boot/firmware/config.txt 2>/dev/null || echo "Config not readable")

--- Service Status ---
$(systemctl status rs300-media-config.service 2>&1 || echo "Service not installed/active")

EOF
}

# Capture context-aware failure diagnostics
capture_failure_diagnostics() {
    local logfile="$1"
    local failure_point="$2"

    echo "" >> "$logfile"
    echo "=== FAILURE DIAGNOSTICS ===" >> "$logfile"
    echo "Failure Point: ${failure_point}" >> "$logfile"
    echo "" >> "$logfile"

    case "$failure_point" in
        driver_load)
            echo "--- Driver Load Failure ---" >> "$logfile"
            dkms status | grep rs300 >> "$logfile" 2>&1 || echo "DKMS status unavailable" >> "$logfile"
            echo "" >> "$logfile"
            echo "Recent errors:" >> "$logfile"
            dmesg | grep -i "rs300.*error\|rs300.*fail" | tail -10 >> "$logfile" 2>&1 || echo "No errors in dmesg" >> "$logfile"
            echo "" >> "$logfile"
            echo "Suggested fix: Reinstall driver with ./setup.sh" >> "$logfile"
            ;;

        hardware_detect)
            echo "--- Hardware Detection Failure ---" >> "$logfile"
            echo "I2C Bus 10 scan:" >> "$logfile"
            i2cdetect -y 10 >> "$logfile" 2>&1 || echo "I2C scan failed" >> "$logfile"
            echo "" >> "$logfile"
            echo "Recent I2C/CSI errors:" >> "$logfile"
            dmesg | grep -i "i2c\|csi" | tail -15 >> "$logfile" 2>&1
            echo "" >> "$logfile"
            echo "Suggested fixes:" >> "$logfile"
            echo "1. Check FPC cable connections (both ends)" >> "$logfile"
            echo "2. Verify 22-pin to 15-pin adapter is seated properly" >> "$logfile"
            echo "3. Check power supply is adequate (27W recommended)" >> "$logfile"
            echo "4. Inspect cable for damage" >> "$logfile"
            ;;

        pipeline_config)
            echo "--- Pipeline Configuration Failure ---" >> "$logfile"
            echo "Current media controller state:" >> "$logfile"
            media-ctl --print-topology 2>&1 | grep -A5 "rs300\|csi2" >> "$logfile"
            echo "" >> "$logfile"
            echo "Format check:" >> "$logfile"
            media-ctl -p 2>&1 | grep "fmt:" | head -10 >> "$logfile"
            echo "" >> "$logfile"
            echo "Suggested fix: rs300 configure" >> "$logfile"
            ;;

        stream_start)
            echo "--- Stream Start Failure ---" >> "$logfile"
            echo "Recent kernel messages:" >> "$logfile"
            dmesg | grep -i "rs300\|rp1-cfe\|csi2" | tail -20 >> "$logfile" 2>&1
            echo "" >> "$logfile"
            echo "Camera status:" >> "$logfile"
            v4l2-ctl -d /dev/v4l-subdev2 --all 2>&1 | head -30 >> "$logfile" || echo "Cannot read camera status" >> "$logfile"
            echo "" >> "$logfile"
            echo "Suggested fixes:" >> "$logfile"
            echo "1. Reconfigure pipeline: rs300 configure" >> "$logfile"
            echo "2. Check for errors: dmesg | grep -i rs300" >> "$logfile"
            echo "3. Run diagnostics: rs300 doctor" >> "$logfile"
            ;;
    esac
}

# Rotate logs (keep last N)
rotate_logs() {
    local command="$1"
    local keep="${2:-$AUTO_ROTATE_COUNT}"
    local log_dir="${RS300_LOGS}/${command}"

    if [ -d "$log_dir" ]; then
        ls -t "$log_dir"/*.log 2>/dev/null | tail -n +$((keep+1)) | xargs rm -f 2>/dev/null || true
    fi
}

# Log to system log
log_to_system() {
    local level="$1"
    local msg="$2"
    local timestamp=$(date '+%Y-%m-%d %H:%M:%S')

    echo "[$timestamp] [${FUNCNAME[2]:-main}] [$level] $msg" >> "$SYSTEM_LOG" 2>/dev/null || true
}

# ============================================================================
# COMMAND IMPLEMENTATIONS
# ============================================================================

# ----------------------------------------------------------------------------
# rs300 status - Quick status check
# ----------------------------------------------------------------------------
cmd_status() {
    print_header "RS300 Camera Status"
    print_header "==================="
    echo ""

    local errors=0
    local warnings=0

    # Check if overlay enabled in config.txt
    print_status "Boot Configuration..."
    if grep -q "dtoverlay=rs300" /boot/firmware/config.txt 2>/dev/null; then
        print_success "Overlay: Enabled in config.txt"
    else
        print_error "Overlay: Not enabled in config.txt"
        echo "  Fix: rs300 enable"
        ((errors++))
    fi

    # Check if driver is loaded
    print_status "Driver Status..."
    if lsmod | grep -q rs300; then
        print_success "Driver: Loaded ($(lsmod | grep rs300 | awk '{print $2}') bytes)"
    else
        print_error "Driver: Not loaded"
        echo "  Fix: sudo modprobe rs300"
        ((errors++))
    fi

    # Check hardware detection
    print_status "Hardware Detection..."
    if i2cdetect -y 10 2>/dev/null | grep -q "3c"; then
        print_success "Hardware: Camera detected on I2C bus 10 (0x3c)"
    else
        print_error "Hardware: Camera not detected"
        echo "  Check: Cable connections, power supply"
        ((errors++))
    fi

    # Check media pipeline
    print_status "Media Pipeline..."
    if media-ctl -p 2>/dev/null | grep -q "rs300"; then
        if media-ctl -p 2>/dev/null | grep -q "ENABLED"; then
            print_success "Pipeline: Configured and enabled"

            # Show current format
            local fmt=$(media-ctl --get-v4l2 "'rs300 10-003c':0" 2>/dev/null | grep -o 'fmt:[^ ]*' || echo "Unknown")
            echo "  Format: $fmt"
        else
            print_warning "Pipeline: Exists but not enabled"
            echo "  Fix: rs300 configure"
            ((warnings++))
        fi
    else
        print_error "Pipeline: Not found"
        echo "  Fix: rs300 configure"
        ((errors++))
    fi

    # Check auto-configuration
    print_status "Auto-Configuration..."
    if systemctl is-enabled rs300-media-config.service >/dev/null 2>&1; then
        print_success "Auto-config: Enabled"
    else
        echo "  ⏸️  Auto-config: Disabled (manual configuration required after each reboot)"
        echo "  Optional: Enable with 'rs300 enable' during camera activation"
    fi

    # Summary
    echo ""
    print_header "========================================="
    if [ $errors -eq 0 ] && [ $warnings -eq 0 ]; then
        print_success "All checks passed! Camera is ready to use."
        echo ""
        echo "Try: rs300 test"
    elif [ $errors -eq 0 ]; then
        print_warning "Camera is functional but has $warnings warning(s)"
    else
        print_error "$errors error(s) detected - see fixes above"
        echo ""
        echo "For detailed diagnostics: rs300 doctor"
    fi

    log_to_system "INFO" "Status check: $errors errors, $warnings warnings"
}

# ----------------------------------------------------------------------------
# rs300 enable - Enable camera (interactive)
# ----------------------------------------------------------------------------
cmd_enable() {
    init_rs300_dirs
    local logfile=$(create_log_file "enable")

    print_header "RS300 Camera Enablement"
    print_header "======================="
    echo ""

    log_to_system "INFO" "Enable command started"
    log_essential_env "$logfile"

    # Check current status
    print_status "Checking current configuration..."
    if grep -q "dtoverlay=rs300" /boot/firmware/config.txt 2>/dev/null; then
        print_success "Already enabled in config.txt"
        echo "" | tee -a "$logfile"

        # Still offer to enable auto-config
        read -p "Enable automatic media configuration at boot? (y/N): " -n 1 -r
        echo

        if [[ $REPLY =~ ^[Yy]$ ]]; then
            sudo systemctl enable rs300-media-config.service 2>&1 | tee -a "$logfile"
            print_success "Auto-configuration enabled"
            log_to_system "INFO" "Auto-configuration enabled"
        fi

        return 0
    fi

    # Detect conflicts
    print_status "Checking for configuration conflicts..." | tee -a "$logfile"

    local conflicts=$(grep -E "^camera_auto_detect=1|^dtoverlay=(imx|ov5647|imx219|imx477|arducam)" /boot/firmware/config.txt 2>/dev/null)

    if [ -n "$conflicts" ]; then
        print_error "Conflicting configuration detected" | tee -a "$logfile"
        echo "" | tee -a "$logfile"
        echo "Found conflicting camera configuration:" | tee -a "$logfile"
        echo "$conflicts" | tee -a "$logfile"
        echo "" | tee -a "$logfile"
        echo "Please manually edit /boot/firmware/config.txt to resolve:"
        echo "  1. Set camera_auto_detect=0 (or remove the line)"
        echo "  2. Comment out or remove other camera overlays"
        echo ""
        echo "Then run 'rs300 enable' again"

        log_to_system "ERROR" "Conflicts detected in config.txt"
        return 1
    fi

    print_success "No conflicts detected" | tee -a "$logfile"
    echo ""

    # Show what will be done
    echo "This will modify /boot/firmware/config.txt"
    echo "Adding:"
    echo "  camera_auto_detect=0"
    echo "  dtoverlay=rs300"
    echo ""

    read -p "Continue? (y/N): " -n 1 -r
    echo

    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        print_status "User cancelled" | tee -a "$logfile"
        log_to_system "INFO" "Enable cancelled by user"
        return 0
    fi

    # Create timestamped backup
    local timestamp=$(date +%Y%m%d-%H%M%S)
    local backup="${RS300_BACKUPS}/config.txt.${timestamp}"

    print_status "Creating backup..." | tee -a "$logfile"
    if sudo cp /boot/firmware/config.txt "$backup"; then
        print_success "Backup created: $backup" | tee -a "$logfile"
        echo "Backup location: $backup" >> "$logfile"
    else
        print_error "Backup failed - aborting" | tee -a "$logfile"
        log_to_system "ERROR" "Backup failed"
        return 1
    fi

    # Make modifications
    print_status "Modifying config.txt..." | tee -a "$logfile"

    {
        echo ""
        echo "# RS300 Thermal Camera - Added by rs300 CLI $(date)"
        echo "camera_auto_detect=0"
        echo "dtoverlay=rs300"
    } | sudo tee -a /boot/firmware/config.txt >> "$logfile"

    # Verify changes
    if grep -q "dtoverlay=rs300" /boot/firmware/config.txt; then
        print_success "Config.txt updated successfully" | tee -a "$logfile"

        # Log what was added
        echo "" >> "$logfile"
        echo "=== Added to config.txt ===" >> "$logfile"
        tail -4 /boot/firmware/config.txt >> "$logfile"

        echo ""
        print_success "RS300 camera enabled in boot configuration"
        echo ""
        echo "Backup location: $backup"
        echo "To rollback: sudo cp $backup /boot/firmware/config.txt"

        log_to_system "INFO" "Config.txt updated successfully"
    else
        print_error "Verification failed" | tee -a "$logfile"
        echo "Restoring backup..."
        sudo cp "$backup" /boot/firmware/config.txt
        log_to_system "ERROR" "Verification failed, backup restored"
        return 1
    fi

    # Offer auto-configuration
    echo ""
    read -p "Enable automatic media configuration at boot? (y/N): " -n 1 -r
    echo

    if [[ $REPLY =~ ^[Yy]$ ]]; then
        sudo systemctl enable rs300-media-config.service 2>&1 | tee -a "$logfile"
        print_success "Auto-configuration enabled" | tee -a "$logfile"
        log_to_system "INFO" "Auto-configuration enabled"
    fi

    echo ""
    print_warning "⚠️  Reboot required: sudo reboot"
    echo ""
    echo "After reboot:"
    if [[ $REPLY =~ ^[Yy]$ ]]; then
        echo "  - Pipeline will be configured automatically"
        echo "  - Test camera: rs300 test"
    else
        echo "  - Configure pipeline: rs300 configure"
        echo "  - Test camera: rs300 test"
    fi

    # Clean up old backups (keep last 5)
    ls -t "${RS300_BACKUPS}"/config.txt.* 2>/dev/null | tail -n +6 | xargs rm -f 2>/dev/null || true

    rotate_logs "enable" 5
}

# ----------------------------------------------------------------------------
# rs300 disable - Disable camera
# ----------------------------------------------------------------------------
cmd_disable() {
    init_rs300_dirs
    local logfile=$(create_log_file "enable")

    print_header "RS300 Camera Disable"
    print_header "===================="
    echo ""

    log_to_system "INFO" "Disable command started"

    # Check if currently enabled
    if ! grep -q "dtoverlay=rs300" /boot/firmware/config.txt 2>/dev/null; then
        print_warning "RS300 is not enabled in config.txt"
        echo ""
    else
        read -p "Remove RS300 from config.txt? (y/N): " -n 1 -r
        echo

        if [[ $REPLY =~ ^[Yy]$ ]]; then
            # Create backup
            local timestamp=$(date +%Y%m%d-%H%M%S)
            local backup="${RS300_BACKUPS}/config.txt.${timestamp}"
            sudo cp /boot/firmware/config.txt "$backup"

            # Remove lines
            sudo sed -i '/# RS300 Thermal Camera/d' /boot/firmware/config.txt
            sudo sed -i '/dtoverlay=rs300/d' /boot/firmware/config.txt

            print_success "Removed from config.txt" | tee -a "$logfile"
            echo "Backup: $backup"
            print_warning "⚠️  Reboot required to take effect"

            log_to_system "INFO" "Removed from config.txt"
        fi
    fi

    # Disable auto-config
    if systemctl is-enabled rs300-media-config.service >/dev/null 2>&1; then
        sudo systemctl disable rs300-media-config.service 2>&1 | tee -a "$logfile"
        print_success "Auto-configuration disabled" | tee -a "$logfile"
        log_to_system "INFO" "Auto-configuration disabled"
    fi
}

# ----------------------------------------------------------------------------
# rs300 configure - Configure media pipeline (wrapper)
# ----------------------------------------------------------------------------
cmd_configure() {
    init_rs300_dirs
    local logfile=$(create_log_file "configure")

    print_status "Starting media pipeline configuration"
    echo "Log file: $logfile"
    echo ""

    log_to_system "INFO" "Configure command started"
    log_essential_env "$logfile"

    echo "" >> "$logfile"
    echo "=== Running rs300-configure ===" >> "$logfile"
    echo "" >> "$logfile"

    # Run the actual configuration script, logging all output
    if rs300-configure "${@}" 2>&1 | tee -a "$logfile"; then
        echo "" >> "$logfile"
        echo "CONFIGURATION RESULT: SUCCESS" >> "$logfile"
        print_success "Media pipeline configured successfully"
        echo ""
        echo "Configuration log: $logfile"

        log_to_system "INFO" "Configuration successful"
    else
        local exit_code=$?
        echo "" >> "$logfile"
        echo "CONFIGURATION RESULT: FAILED (exit code: $exit_code)" >> "$logfile"
        print_error "Configuration failed"
        echo ""
        echo "Configuration log: $logfile"
        echo "Run 'rs300 doctor' for diagnostics"

        log_to_system "ERROR" "Configuration failed with exit code $exit_code"
        return $exit_code
    fi

    rotate_logs "configure" 10
}

# ----------------------------------------------------------------------------
# rs300 test - Stream test with smart logging
# ----------------------------------------------------------------------------
cmd_test() {
    init_rs300_dirs
    local logfile=$(create_log_file "test")
    local start_time=$(date +%s)

    print_header "RS300 Camera Test"
    print_header "================="
    echo ""

    log_to_system "INFO" "Test started"
    log_essential_env "$logfile"

    local failure_point=""

    # Pre-flight checks
    echo "=== Pre-Flight Checks ===" >> "$logfile"
    echo ""
    print_status "Running pre-flight checks..."

    # Check 1: Driver loaded
    if ! lsmod | grep -q rs300; then
        failure_point="driver_load"
        print_error "Driver not loaded" | tee -a "$logfile"
        echo "  Fix: sudo modprobe rs300"
        capture_failure_diagnostics "$logfile" "$failure_point"
        log_to_system "ERROR" "Test failed: driver not loaded"
        return 1
    fi
    echo "[✅] Driver loaded: rs300 (size: $(lsmod | grep rs300 | awk '{print $2}'))" | tee -a "$logfile"

    # Check 2: Hardware detected
    if ! i2cdetect -y 10 2>/dev/null | grep -q "3c"; then
        failure_point="hardware_detect"
        print_error "Camera not detected on I2C bus 10" | tee -a "$logfile"
        echo "  Check: Cable connections, power supply"
        capture_failure_diagnostics "$logfile" "$failure_point"
        log_to_system "ERROR" "Test failed: hardware not detected"
        return 1
    fi
    echo "[✅] I2C device: 0x3c detected on bus 10" | tee -a "$logfile"

    # Check 3: Video device exists
    if ! [ -e /dev/video0 ]; then
        failure_point="pipeline_config"
        print_error "Video device not found" | tee -a "$logfile"
        echo "  Fix: rs300 configure"
        capture_failure_diagnostics "$logfile" "$failure_point"
        log_to_system "ERROR" "Test failed: video device not found"
        return 1
    fi
    echo "[✅] Video device: /dev/video0 ($(v4l2-ctl -d /dev/video0 --info 2>/dev/null | grep 'Card type' | cut -d':' -f2 | xargs))" | tee -a "$logfile"

    # Check 4: Pipeline configured
    if ! media-ctl -p 2>/dev/null | grep -q "rs300.*ENABLED"; then
        print_warning "Media pipeline not configured" | tee -a "$logfile"
        echo "  Recommended: rs300 configure"
        read -p "Continue anyway? (y/N): " -n 1 -r
        echo
        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            log_to_system "INFO" "Test cancelled by user (pipeline not configured)"
            return 0
        fi
    else
        echo "[✅] Media pipeline: Configured, link ENABLED" | tee -a "$logfile"
    fi

    # Check 5: Get current format
    local current_fmt=$(media-ctl --get-v4l2 "'rs300 10-003c':0" 2>/dev/null | grep -o 'fmt:[^ ]*' | cut -d':' -f2 || echo "Unknown")
    local current_res=$(media-ctl --get-v4l2 "'rs300 10-003c':0" 2>/dev/null | grep -oE '[0-9]+x[0-9]+' | head -1 || echo "Unknown")
    echo "[✅] Format: ${current_fmt}/${current_res}" | tee -a "$logfile"

    echo ""
    print_success "Pre-flight checks complete"
    echo ""

    # Stream test
    echo "" >> "$logfile"
    echo "=== Stream Test (10 seconds) ===" >> "$logfile"
    echo "" >> "$logfile"

    print_status "Streaming for 10 seconds (verbose output logged)..."

    # Run stream test with verbose output
    if timeout 10s v4l2-ctl -d /dev/video0 --stream-mmap --stream-to=/dev/null --verbose 2>&1 | tee -a "$logfile"; then
        local end_time=$(date +%s)
        local duration=$((end_time - start_time))

        # Extract metrics from log
        local fps=$(grep -o "[0-9.]\+ fps" "$logfile" | tail -1 | awk '{print $1}')
        local frames=$(grep "frames captured" "$logfile" | tail -1 | awk '{print $1}')

        echo "" >> "$logfile"
        echo "=== Test Result ===" >> "$logfile"
        echo "Status: PASSED ✅" >> "$logfile"
        echo "Exit code: 0" >> "$logfile"
        [ -n "$fps" ] && echo "FPS: $fps (expected: ~60)" >> "$logfile"
        [ -n "$frames" ] && echo "Frames: $frames" >> "$logfile"
        echo "Duration: ${duration}s" >> "$logfile"

        echo ""
        print_success "Camera streaming test PASSED"

        if [ -n "$fps" ]; then
            local expected_fps=60
            local fps_int=${fps%.*}
            local delta=$((expected_fps - fps_int))

            if [ $delta -lt -5 ] || [ $delta -gt 5 ]; then
                print_warning "FPS: $fps (expected: ~${expected_fps}, delta: ${delta})"
            else
                echo "  FPS: $fps ✅"
            fi
        fi

        [ -n "$frames" ] && echo "  Frames: $frames"

        log_to_system "INFO" "Test passed: $fps fps, $frames frames"
    else
        local exit_code=$?
        local end_time=$(date +%s)
        local duration=$((end_time - start_time))

        failure_point="stream_start"

        echo "" >> "$logfile"
        echo "=== Test Result ===" >> "$logfile"
        echo "Status: FAILED ❌" >> "$logfile"
        echo "Exit code: $exit_code" >> "$logfile"
        echo "Duration: ${duration}s" >> "$logfile"

        if [ $duration -lt 3 ]; then
            echo "Note: Failed too quickly (< 3s), likely a configuration issue" >> "$logfile"
        fi

        print_error "Camera streaming test FAILED (exit code: $exit_code)"

        capture_failure_diagnostics "$logfile" "$failure_point"

        echo ""
        print_status "Run 'rs300 doctor' for detailed diagnostics"

        log_to_system "ERROR" "Test failed with exit code $exit_code after ${duration}s"
    fi

    echo ""
    print_status "Full test log: $logfile"
    echo "  View: cat $logfile"
    echo "  Share for support: rs300 logs"

    rotate_logs "test" 10
}

# ----------------------------------------------------------------------------
# rs300 doctor - Comprehensive diagnostics
# ----------------------------------------------------------------------------
cmd_doctor() {
    init_rs300_dirs
    local logfile=$(create_log_file "doctor")

    print_header "RS300 Comprehensive Diagnostics"
    print_header "================================"
    echo ""

    log_to_system "INFO" "Doctor diagnostics started"
    log_essential_env "$logfile"
    capture_system_context "$logfile"

    local errors=0
    local warnings=0

    # Hardware detection
    print_header "=== Hardware Detection ===" | tee -a "$logfile"
    echo ""
    if i2cdetect -y 10 2>&1 | tee -a "$logfile" | grep -q "3c"; then
        print_success "Camera detected on I2C bus 10 at 0x3c" | tee -a "$logfile"
    else
        print_error "Camera NOT detected on I2C bus 10" | tee -a "$logfile"
        ((errors++))
        echo "  Check: Cable connections, power supply" | tee -a "$logfile"
    fi
    echo ""

    # Driver status
    print_header "=== Driver Status ===" | tee -a "$logfile"
    echo ""
    if lsmod | grep -q rs300; then
        print_success "rs300 driver loaded" | tee -a "$logfile"
        lsmod | grep rs300 | tee -a "$logfile"
    else
        print_error "rs300 driver NOT loaded" | tee -a "$logfile"
        ((errors++))
        echo "  Fix: sudo modprobe rs300" | tee -a "$logfile"
    fi
    echo ""

    # DKMS status
    print_header "=== DKMS Status ===" | tee -a "$logfile"
    echo ""
    dkms status | grep rs300 | tee -a "$logfile" || {
        print_warning "rs300 not found in DKMS" | tee -a "$logfile"
        ((warnings++))
    }
    echo ""

    # Config.txt check
    print_header "=== Boot Configuration ===" | tee -a "$logfile"
    echo ""
    if grep -q "dtoverlay=rs300" /boot/firmware/config.txt 2>/dev/null; then
        print_success "RS300 overlay enabled in config.txt" | tee -a "$logfile"
    else
        print_error "RS300 overlay NOT enabled" | tee -a "$logfile"
        ((errors++))
        echo "  Fix: rs300 enable" | tee -a "$logfile"
    fi

    if grep -q "^camera_auto_detect=1" /boot/firmware/config.txt 2>/dev/null; then
        print_warning "camera_auto_detect=1 detected (should be 0)" | tee -a "$logfile"
        ((warnings++))
    fi
    echo ""

    # Media pipeline
    print_header "=== Media Pipeline ===" | tee -a "$logfile"
    echo ""
    if media-ctl -p 2>/dev/null | tee -a "$logfile" | head -50 | grep -q "rs300"; then
        if media-ctl -p 2>/dev/null | grep -q "ENABLED"; then
            print_success "Media pipeline configured and enabled" | tee -a "$logfile"
        else
            print_warning "Media pipeline exists but not enabled" | tee -a "$logfile"
            ((warnings++))
            echo "  Fix: rs300 configure" | tee -a "$logfile"
        fi
    else
        print_error "Media pipeline not found" | tee -a "$logfile"
        ((errors++))
        echo "  Fix: rs300 configure" | tee -a "$logfile"
    fi
    echo ""

    # Auto-configuration status
    print_header "=== Auto-Configuration ===" | tee -a "$logfile"
    echo ""
    if systemctl is-enabled rs300-media-config.service >/dev/null 2>&1; then
        print_success "Auto-configuration enabled" | tee -a "$logfile"
        systemctl status rs300-media-config.service --no-pager 2>&1 | head -15 | tee -a "$logfile"
    else
        print_status "Auto-configuration not enabled (optional)" | tee -a "$logfile"
        echo "  Enable during camera activation with: rs300 enable" | tee -a "$logfile"
    fi
    echo ""

    # Recent kernel messages
    print_header "=== Recent Kernel Messages ===" | tee -a "$logfile"
    echo ""
    dmesg | grep -i "rs300\|csi2\|rp1-cfe" | tail -20 | tee -a "$logfile"
    echo ""

    # Power/Thermal status
    print_header "=== Power & Thermal Status ===" | tee -a "$logfile"
    echo ""
    local throttled=$(vcgencmd get_throttled 2>/dev/null | cut -d'=' -f2)
    if [ "$throttled" = "0x0" ]; then
        print_success "No throttling detected" | tee -a "$logfile"
    else
        print_warning "Throttling detected: $throttled" | tee -a "$logfile"
        ((warnings++))
    fi

    local temp=$(vcgencmd measure_temp 2>/dev/null | cut -d'=' -f2)
    echo "Temperature: $temp" | tee -a "$logfile"
    echo ""

    # Summary
    print_header "========================================" | tee -a "$logfile"
    print_header "Diagnostic Summary:" | tee -a "$logfile"
    echo "  Errors: $errors" | tee -a "$logfile"
    echo "  Warnings: $warnings" | tee -a "$logfile"
    echo "" | tee -a "$logfile"

    if [ $errors -eq 0 ] && [ $warnings -eq 0 ]; then
        print_success "All checks passed!" | tee -a "$logfile"
    elif [ $errors -eq 0 ]; then
        print_warning "Some warnings detected" | tee -a "$logfile"
    else
        print_error "Issues detected - see above for fixes" | tee -a "$logfile"
    fi

    echo ""
    print_status "Full diagnostic log: $logfile"

    log_to_system "INFO" "Doctor complete: $errors errors, $warnings warnings"
    rotate_logs "doctor" 5
}

# ----------------------------------------------------------------------------
# rs300 logs - Log management
# ----------------------------------------------------------------------------
cmd_logs() {
    init_rs300_dirs

    local action="${1:-create}"

    case "$action" in
        create|collect)
            print_header "RS300 Log Collection"
            print_header "===================="
            echo ""

            local archive="rs300-logs-$(date +%Y%m%d-%H%M%S).tar.gz"

            if [ ! -d "$RS300_LOGS" ] || [ -z "$(ls -A "$RS300_LOGS" 2>/dev/null)" ]; then
                print_warning "No logs found"
                echo "Run 'rs300 test' to generate test logs"
                return 1
            fi

            # Show available logs
            print_status "Available logs:"
            for type in test configure doctor enable; do
                local count=$(ls "${RS300_LOGS}/${type}"/*.log 2>/dev/null | wc -l)
                if [ $count -gt 0 ]; then
                    echo "  ${type}: $count logs"
                fi
            done
            echo ""

            # Create comprehensive archive
            print_status "Creating diagnostic archive..."

            local temp_dir=$(mktemp -d)
            mkdir -p "$temp_dir/rs300-logs"

            # Copy all logs
            cp -r "$RS300_LOGS"/* "$temp_dir/rs300-logs/" 2>/dev/null || true

            # Add system information
            {
                echo "RS300 Diagnostic Report - $(date)"
                echo "========================================"
                echo ""
                echo "=== System Info ==="
                uname -a
                grep PRETTY_NAME /etc/os-release 2>/dev/null
                echo ""
                echo "=== Kernel Version ==="
                uname -r
                echo ""
                echo "=== Driver Status ==="
                lsmod | grep rs300
                dkms status | grep rs300
                echo ""
                echo "=== Hardware Detection ==="
                i2cdetect -y 10 2>/dev/null || echo "I2C scan failed"
                echo ""
                echo "=== Media Controller ==="
                media-ctl --print-topology 2>&1 | head -100
                echo ""
                echo "=== Recent Kernel Messages ==="
                dmesg | grep -i "rs300\|csi2\|rp1-cfe" | tail -50
                echo ""
                echo "=== Config.txt ==="
                grep -E "camera|dtoverlay" /boot/firmware/config.txt 2>/dev/null || echo "Config not readable"
                echo ""
                echo "=== Service Status ==="
                systemctl status rs300-media-config.service 2>&1 || echo "Service not installed"
            } > "$temp_dir/rs300-logs/system-info.txt"

            # Create archive
            tar -czf "$archive" -C "$temp_dir" rs300-logs 2>/dev/null
            rm -rf "$temp_dir"

            if [ -f "$archive" ]; then
                print_success "Diagnostic archive created: $archive"
                echo ""
                echo "Please attach this file when reporting issues:"
                echo "  https://github.com/Kodrea/rs300-v4l2-driver/issues"
                echo ""
                ls -lh "$archive"

                log_to_system "INFO" "Log archive created: $archive"
            else
                print_error "Failed to create archive"
                return 1
            fi
            ;;

        view)
            local log_type="${2:-test}"
            local latest=$(ls -t "${RS300_LOGS}/${log_type}"/*.log 2>/dev/null | head -1)

            if [ -n "$latest" ]; then
                echo "=== Latest ${log_type} log ==="
                echo "File: $latest"
                echo ""
                cat "$latest"
            else
                print_warning "No ${log_type} logs found"
                echo "Available types: test, configure, doctor, enable"
            fi
            ;;

        list)
            print_header "Available Logs"
            print_header "=============="
            echo ""
            echo "Location: ${RS300_LOGS}"
            echo ""

            for type in test configure doctor enable; do
                local count=$(ls "${RS300_LOGS}/${type}"/*.log 2>/dev/null | wc -l)
                if [ $count -gt 0 ]; then
                    echo "${type}: $count logs"
                    ls -lh "${RS300_LOGS}/${type}"/*.log 2>/dev/null | tail -3 | awk '{print "    " $9 " (" $5 ")"}'
                    echo ""
                fi
            done

            if [ -f "$SYSTEM_LOG" ]; then
                echo "System log: ${SYSTEM_LOG}"
                local lines=$(wc -l < "$SYSTEM_LOG")
                echo "  Lines: $lines"
                echo ""
            fi
            ;;

        clean)
            read -p "Delete all logs except most recent 3 of each type? (y/N): " -n 1 -r
            echo

            if [[ $REPLY =~ ^[Yy]$ ]]; then
                for type in test configure doctor enable; do
                    rotate_logs "$type" 3
                done
                print_success "Old logs cleaned"
                log_to_system "INFO" "Logs cleaned (kept 3 most recent)"
            fi
            ;;

        *)
            echo "Usage: rs300 logs [create|view|list|clean]"
            echo ""
            echo "  create  - Create diagnostic archive for bug reports (default)"
            echo "  view    - View latest log (rs300 logs view [type])"
            echo "  list    - List all available logs"
            echo "  clean   - Remove old logs (keep recent 3)"
            ;;
    esac
}

# ----------------------------------------------------------------------------
# rs300 help - Show help
# ----------------------------------------------------------------------------
cmd_help() {
    cat <<EOF
RS300 Thermal Camera Control v${VERSION}

Usage: rs300 <command> [options]

Commands:
    status      Show current camera status
    enable      Enable camera (modifies config.txt, requires reboot)
    disable     Disable camera (removes from config.txt)
    configure   Configure media pipeline (logged)
    test        Test camera streaming for 10s (logged, verbose)
    doctor      Run comprehensive diagnostics (logged)
    logs        Manage logs (create|view|list|clean)
    help        Show this help

Logging:
    All commands log to ~/.rs300/logs/
    System log: ~/.rs300/logs/system.log

Examples:
    rs300 status                 # Quick status check
    rs300 enable                 # Enable camera (interactive)
    rs300 configure              # Configure pipeline (logged)
    rs300 test                   # 10s stream test with logging
    rs300 doctor                 # Full diagnostics
    rs300 logs                   # Create support archive
    rs300 logs view test         # View latest test log
    rs300 logs list              # List all logs

Environment:
    RS300_DEBUG=1                # Enable debug output

For issues: https://github.com/Kodrea/rs300-v4l2-driver/issues
EOF
}

# ============================================================================
# MAIN
# ============================================================================

# Initialize system log
init_rs300_dirs
touch "$SYSTEM_LOG" 2>/dev/null || true

# Parse command
COMMAND="${1:-help}"
shift 2>/dev/null || true

# Dispatch
case "$COMMAND" in
    status)     cmd_status "$@" ;;
    enable)     cmd_enable "$@" ;;
    disable)    cmd_disable "$@" ;;
    configure)  cmd_configure "$@" ;;
    test)       cmd_test "$@" ;;
    doctor)     cmd_doctor "$@" ;;
    logs)       cmd_logs "$@" ;;
    help|--help|-h) cmd_help ;;
    --version|-v) echo "rs300 version ${VERSION}" ;;
    *)
        print_error "Unknown command: $COMMAND"
        echo ""
        cmd_help
        exit 1
        ;;
esac
